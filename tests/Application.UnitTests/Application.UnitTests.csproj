<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>IrcMonitor.Application.UnitTests</RootNamespace>
        <AssemblyName>IrcMonitor.Application.UnitTests</AssemblyName>

        <IsPackable>false</IsPackable>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
        <PackageReference Include="nunit" Version="4.4.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="5.1.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" Version="7.2.0" />
        <PackageReference Include="Moq" Version="4.21.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\IrcMonitor.Application\IrcMonitor.Application.csproj" />
        <ProjectReference Include="..\..\src\IrcMonitor.Infrastructure\IrcMonitor.Infrastructure.csproj" />
    </ItemGroup>

</Project>
